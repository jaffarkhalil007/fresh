# ─────────────────────────────────────────────────
# HAMAASH — Environment Variable
# Copy this file to .env and fill in real values.
# Never commit .env to Git.
# ─────────────────────────────────────────────────

# ── Clerk (Authentication) ────────────────────────
# Get from: https://dashboard.clerk.com → Your App → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase (Database + Storage) ────────────────
# Get from: https://supabase.com/dashboard → Project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...   # anon / public key only

# ── Admin ────────────────────────────────────────
# The email address of the store owner / admin account.
# Used as a fast-path admin check on the frontend.
VITE_ADMIN_EMAIL=owner@yourdomain.com

# ─────────────────────────────────────────────────
# The variables below are SERVER-ONLY.
# Set them as Supabase Edge Function secrets — never prefix with VITE_.
# Run: supabase secrets set KEY=value
# ─────────────────────────────────────────────────

# ── Resend (Email) ───────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# A verified sender address in your Resend account / domain
RESEND_SENDER_EMAIL=noreply@yourdomain.com
# Where contact-form and new-order notifications are delivered
ADMIN_EMAIL=owner@yourdomain.com

# ── Clerk (server-side, Edge Functions only) ─────
# Get from: https://dashboard.clerk.com → API Keys → Secret keys
# CLERK_SECRET_KEY=your_clerk_secret_key

# ── Stripe (optional — payment gateway) ──────────
# Get from: https://dashboard.stripe.com → Developers → API keys
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
